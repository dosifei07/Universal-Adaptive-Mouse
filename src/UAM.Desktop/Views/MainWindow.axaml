<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UAM.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="UAM.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Universal Adaptive Mouse">

    <!-- Placeholder shell. The sidebar and page views arrive in v0.2 batch B;
         until then this shows which page the view model has navigated to. -->
    <TextBlock Text="{Binding CurrentTitle}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

</Window>
