<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the desktop presentation layer. No Avalonia reference: these run
    on a headless Linux machine like every other UAM test project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UAM.Core\UAM.Core.csproj" />
    <ProjectReference Include="..\..\src\UAM.Data\UAM.Data.csproj" />
    <ProjectReference Include="..\..\src\UAM.Application\UAM.Application.csproj" />
    <ProjectReference Include="..\..\src\UAM.Desktop.Shared\UAM.Desktop.Shared.csproj" />
    <ProjectReference Include="..\..\src\UAM.Desktop.ViewModels\UAM.Desktop.ViewModels.csproj" />
  </ItemGroup>

</Project>
